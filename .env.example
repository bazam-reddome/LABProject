# Database (used by both the app and the postgres service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lms

# Connection string the Next.js app uses to reach Postgres.
# Inside docker-compose the host is the service name `db`.
DATABASE_URL=postgres://postgres:postgres@db:5432/lms

# Sign your JWTs. Use a long, random value in production.
JWT_SECRET=please-change-me-to-a-long-random-string

# Public base URL (optional — used for absolute links if you add them).
NEXTAUTH_URL=http://localhost:3000

# When `true`, the app seeds 1 instructor + 1 student + 1 course on first boot.
SEED=true
